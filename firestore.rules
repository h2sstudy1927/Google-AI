rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email in ['pinturanmal2@gmail.com', 'admin@h2sstudy.com']) ||
        (request.auth.token.admin == true)
      );
    }

    function isValidUser(data, userId) {
      return data.userId == userId &&
             data.email is string &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('targetExam' in data) || data.targetExam is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidMockResult(data, userId) {
      return data.id is string &&
             data.userId == userId &&
             data.testId is string &&
             data.score is number &&
             data.totalQuestions is number &&
             (!('testTitle' in data) || data.testTitle is string) &&
             (!('category' in data) || data.category is string) &&
             (!('correctAnswers' in data) || data.correctAnswers is number) &&
             (!('incorrectAnswers' in data) || data.incorrectAnswers is number) &&
             (!('timeTakenSeconds' in data) || data.timeTakenSeconds is number) &&
             (!('completedAt' in data) || data.completedAt is timestamp);
    }

    // 1. Student private profile and scores isolation (only owner or admin)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId) || isAdmin();

      // Subcollection for mock results (strictly private student data)
      match /mock_results/{resultId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidMockResult(request.resource.data, userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Subcollection for private backups
      match /backups/{backupId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Admin panel & teacher approval requests (admin permissions only for review)
    match /teacher_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 3. Custom Mock Tests (read by authenticated students, authoring restricted to admin/teachers)
    match /custom_mock_tests/{testId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 4. Public catalog read for logged-in users
    match /exam_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
